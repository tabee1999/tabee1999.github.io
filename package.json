{
  "name": "tabeeda-shakir-portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Portfolio of Tabeeda Shakir, Senior QA Engineer. React + TypeScript + Tailwind CSS, pre-rendered for SEO and tested with Playwright.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs --port 4321 --dir dist",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs --port 4321 --dir dist",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:chrome": "playwright test --project=desktop-chrome --project=mobile-chrome",
    "test:worker": "node --test chat-worker/worker.test.mjs",
    "test:live": "BASE_URL=https://tabee1999.github.io/ playwright test --grep @smoke",
    "check:links": "node scripts/check-links.mjs",
    "lighthouse": "lhci autorun",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "test:allure": "ALLURE=1 playwright test; allure generate ./allure-results && allure open"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "allure": "^3.0.0",
    "allure-js-commons": "^3.0.0",
    "allure-playwright": "^3.0.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
