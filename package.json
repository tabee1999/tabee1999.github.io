{
  "name": "tabeeda-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio of Tabeeda Shakir, Senior QA Engineer. A static site with a Playwright test suite.",
  "scripts": {
    "build": "node build.mjs",
    "build:strict": "node build.mjs --strict",
    "placeholders": "node build.mjs --list-placeholders",
    "preview": "node build.mjs && node scripts/serve.mjs --port 4321",
    "draft": "node build.mjs --draft && node scripts/serve.mjs --port 4321",
    "test": "playwright test",
    "test:chrome": "playwright test --project=desktop-chrome --project=mobile-chrome",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "lighthouse": "node build.mjs && lhci autorun",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
